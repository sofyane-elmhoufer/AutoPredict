# ------------------------------------------------------
# Serveur
# ------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------
# Base de données MySQL
# ------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=autopredict
DB_USER=root
DB_PASSWORD=changeme

# ------------------------------------------------------
# JWT (authentification)
# ------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# ------------------------------------------------------
# Service Machine Learning (API Python de l'équipe Data/ML)
# ------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=8000
# Si le microservice ML expose une clé d'API interne
ML_SERVICE_API_KEY=

# ------------------------------------------------------
# Normalisation du cache
# ------------------------------------------------------
# Pas d'arrondi du kilométrage (en km) pour la clé de cache
KM_ROUNDING_STEP=5000
